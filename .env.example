# Optional: Gemini API Key for codebase Q&A assistant queries
# If not provided, the platform automatically falls back to deterministic graph indexing.
GEMINI_API_KEY=

# Optional: GitHub Personal Access Token
# Increases GitHub REST API rate limits from 60 requests/hour to 5,000 requests/hour for public repository analysis.
GITHUB_TOKEN=

# Port for the Express server and Vite development middleware (default: 3000)
PORT=3000

